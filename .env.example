# Required Environment Variables

# 1. LLM API Key (Choose one)
# We recommend Google Gemini for its 1M+ context window and strong reasoning.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Observability (LangSmith - Recommended for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="ai-spiritual-knowledge-rag"

# 3. Local Tracing (Arize Phoenix - Optional)
# Run `python src/cli.py phoenix` to start the local collector.
PHOENIX_COLLECTOR_HTTP_ENDPOINT=http://localhost:6006

# 4. Storage & Processing
# (Optional) Customize paths if not using defaults
# INDEX_PATH=./data/indices
# PROCESSED_DATA_PATH=./data/processed
